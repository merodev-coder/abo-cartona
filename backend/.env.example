MONGODB_URI=your_mongodb_connection_string
PORT=5001
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=
BOSTA_API_KEY=your_bosta_api_key_here

# Admin credentials are server-only. Never use NEXT_PUBLIC_ADMIN_*.
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET=
# Set to the actual number of trusted reverse proxies; 0 for direct access.
TRUST_PROXY_HOPS=0
MONGO_MAX_POOL_SIZE=30

# Enable only the payment destinations actually owned/configured by the store.
PAYMENT_VODAFONE_DESTINATION=
PAYMENT_INSTAPAY_DESTINATION=

# Use the existing UploadThing application's v7 token on this backend as well.
# Must be the dashboard's base64 v7 token, not a raw sk_ API key.
# Configured destinations remain visible if this token is missing or malformed.
# Enable private ACL overrides in UploadThing; uploads fail closed if unsupported.
UPLOADTHING_TOKEN=
PROOF_MAX_BYTES=5242880

# Optional legacy S3 read/cleanup only; not needed for new UploadThing proofs.
PROOF_S3_BUCKET=
PROOF_S3_REGION=auto
PROOF_S3_ENDPOINT=
PROOF_S3_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORE_NAME=أبو كرتونة
# Pickup address is القاهرة - حدائق حلوان; no street or map coordinates assumed.
STORE_PICKUP_HOURS=
STORE_CONTACT_PHONE=
