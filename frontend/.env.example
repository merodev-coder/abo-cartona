# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://your-backend-url.up.railway.app

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Authentication
JWT_SECRET=your-super-secret-jwt-key
# Must match the backend JWT secret for protected legacy Next.js admin routes.
# Admin credentials belong on the backend only; never define NEXT_PUBLIC_ADMIN_*.

# File Upload (UploadThing)
UPLOADTHING_TOKEN=
UPLOADTHING_SECRET=your-uploadthing-secret
UPLOADTHING_APP_ID=your-uploadthing-app-id

# Other environment variables
NODE_ENV=production
